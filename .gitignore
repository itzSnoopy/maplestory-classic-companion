# --- Secrets / personal settings (local only) ---
# local tracker settings; created from config.example.json on first run
config.json
# character name, Discord settings (helper_settings.py has built-in defaults)
helper_settings.json

# --- Nexon game imagery: NEVER commit (screenshots, frames, UI crops, game art) ---
*.png
*.jpg
*.jpeg
*.bmp
*.gif
# Allowed: Microsoft Fluent Emoji maple leaf (MIT) and the placeholder built from it. Not Nexon art.
!/discord_icon.png
!/art/fluent_maple_leaf_3d.png
# Allowed: app-only screenshots for the docs (anonymized data, placeholder photos, no game imagery)
!/docs/img/*.png
screenshots/
# saved game frames kept for offline tests (Nexon imagery, local only)
/dev/fixtures/
# Steam store capsules for the diary's game references (third-party art, cached locally)
game_icons/
crops/
templates/

# Glyph bitmaps read from the game's HUD font (learned locally)
glyphs.json
glyphs_level.json
glyphs_ui.json
glyphs_hud.json
# the skill bar's live feed (player data)
/live.json
glyphs/

# --- Personal play data and live state ---
/sessions/
/history/
/digest.json
/status.json
/diary.md
/diary.html
/journal.md
/stop

# --- Logs, caches ---
*.log
*.log.*
__pycache__/
*.pyc
.venv/
venv/


# --- Build output ---
/build/
/dist/

# --- Claude Code project files (handoff notes, skills): local only ---
/.claude/
