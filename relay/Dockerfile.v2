# Relay v2 (relayd): rooms, admin page, v1 bridge. Standard library only, no pip installs.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data \
    PORT=8787

WORKDIR /app
COPY party_relay.py ./
COPY relayd ./relayd

# /data is owned by the app user, so a fresh named volume starts writable
RUN useradd --system --uid 10001 --no-create-home relay \
    && mkdir -p /data && chown relay:relay /data
USER relay

EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=4).status == 200 else 1)"
CMD ["python", "-m", "relayd"]
